# Server port (Docker & AI Studio expect 3000)
PORT=3000

# SQLite persistent file path (in Docker, mount a volume at /data)
NEURONEST_DB_PATH="./data/neuronest.sqlite"

# Optional secret used to encrypt stored model API tokens (set a strong random string on your VPS)
NEURONEST_SECRET=""

# Optional pre-shared bearer key for external agents pushing telemetry to POST /api/telemetry/events
# If left empty, NeuroNest generates and persists one in SQLite on first boot.
NEURONEST_INGEST_KEY=""

# Optional server credential for Codex chat. An admin can also save a key in the chat settings.
OPENAI_API_KEY=""
CODEX_MODEL=gpt-6.2-sol

# APP_URL: Public URL where your NeuroNest instance is hosted (e.g. https://agents.yourdomain.com)
APP_URL="http://localhost:3000"
